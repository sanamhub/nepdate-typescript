{
  "name": "nepdate-core",
  "version": "0.1.0-beta.1",
  "description": "Bikram Sambat (Nepali calendar) dates: conversion, arithmetic, formatting and parsing.",
  "license": "MIT",
  "keywords": [
    "bikram-sambat",
    "nepali-date",
    "nepali-calendar",
    "bs-ad",
    "date-conversion"
  ],
  "homepage": "https://github.com/sanamhub/nepdate-typescript#readme",
  "bugs": "https://github.com/sanamhub/nepdate-typescript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanamhub/nepdate-typescript.git",
    "directory": "packages/nepdate"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "prepack": "node -e \"for (const [from, to] of [['../../LICENSE', 'LICENSE'], ['../../shared/data/NOTICE', 'NOTICE'], ['../../README.md', 'README.md']]) require('node:fs').copyFileSync(from, to)\""
  }
}
