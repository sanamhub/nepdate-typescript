{
  "name": "nepdate-patro",
  "version": "0.1.0-beta.1",
  "description": "The Nepali patro for nepdate-core: tithi, public holidays and events.",
  "license": "MIT",
  "keywords": [
    "bikram-sambat",
    "nepali-calendar",
    "patro",
    "tithi",
    "nepal-holidays"
  ],
  "homepage": "https://github.com/sanamhub/nepdate-typescript#readme",
  "bugs": "https://github.com/sanamhub/nepdate-typescript/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sanamhub/nepdate-typescript.git",
    "directory": "packages/nepdate-patro"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "test": "vitest run --coverage",
    "prepack": "node -e \"for (const [from, to] of [['../../LICENSE', 'LICENSE'], ['../../shared/data/NOTICE', 'NOTICE']]) require('node:fs').copyFileSync(from, to)\"",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "peerDependencies": {
    "nepdate-core": "~0.1.0-beta.1"
  }
}
